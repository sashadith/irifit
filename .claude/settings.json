{
  "model": "claude-fable-5",
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$(basename \"$f\")\" in .env|.env.*|.iri-*.env) echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Secret-Datei: .env- und .iri-*.env-Dateien sind für Edit/Write gesperrt (Hook secret-guard).\"}}';; esac; }",
            "statusMessage": "Secret-Guard prüft Dateipfad"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/expo-pin-guard.py\"",
            "statusMessage": "Expo-SDK-Pin wird geprüft"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__tabs_context",
      "Bash(npx tsc --noEmit)",
      "Bash(npx expo-doctor)",
      "Bash(npx expo lint)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun simctl listapps *)",
      "Bash(npm run build)",
      "mcp__claude-in-chrome__computer",
      "mcp__Claude_Code_iOS_Simulator__control",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__file_upload",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(sips:*)",
      "Bash(xcrun:*)",
      "Bash(xcodebuild:*)",
      "Bash(npx eas-cli@latest:*)"
    ]
  }
}
