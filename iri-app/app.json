{
  "expo": {
    "name": "IriFit",
    "slug": "iri-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iri",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.irinadith.irifit",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "IRI nutzt die Kamera, um deine Mahlzeiten zu fotografieren und die Nährwerte zu schätzen. Fotos werden nicht gespeichert."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "IRI greift auf deine Fotos zu, wenn du ein vorhandenes Bild einer Mahlzeit analysieren möchtest."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF3F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "sashadith",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1af6bc59-c307-4a30-8911-86122289281f"
      }
    }
  }
}