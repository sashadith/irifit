# irinadith.com — Caching
#
# Hostinger liefert per Default fuer ALLES max-age=604800 (eine Woche). Bei HTML
# heisst das: wer die Seite einmal offen hatte, sieht Textaenderungen erst nach
# Tagen. Darum HTML kurz halten und nur die versionierten Assets lange cachen.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # CSS/JS werden ueber ?v=... versioniert — duerfen lange liegen bleiben
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Zugangsdaten des Mailversands: PHP fuehrt die Datei ohnehin aus statt sie
# auszuliefern — diese Regel ist die zweite Sicherung, falls PHP je ausfaellt
# und der Server die Datei dann als Text ausgeben wuerde.
<Files "smtp-config.php">
  Require all denied
</Files>

# Die PHPMailer-Bibliothek wird nur eingebunden, nie direkt aufgerufen
<FilesMatch "^(PHPMailer|SMTP|Exception)\.php$">
  Require all denied
</FilesMatch>
